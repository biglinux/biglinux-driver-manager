<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>BigLinux</vendor>
  <vendor_url>https://www.biglinux.com.br</vendor_url>
  <icon_name>br.com.biglinux.drivermanager</icon_name>

  <action id="br.com.biglinux.drivermanager.cli">
    <description>Install or remove drivers, kernels and Mesa</description>
    <description xml:lang="be">Усталяванне або выдаленне драйвераў, ядраў і Mesa</description>
    <description xml:lang="bg">Инсталиране или премахване на драйвери, ядра и Mesa</description>
    <description xml:lang="cs">Instalovat nebo odebrat ovladače, jádra a Mesa</description>
    <description xml:lang="da">Installer eller fjern drivere, kerner og Mesa</description>
    <description xml:lang="de">Treiber, Kernel und Mesa installieren oder entfernen</description>
    <description xml:lang="el">Εγκατάσταση ή αφαίρεση οδηγών, πυρήνων και Mesa</description>
    <description xml:lang="es">Instalar o eliminar controladores, núcleos y Mesa</description>
    <description xml:lang="et">Draiverite, kernelite ja Mesa paigaldamine või eemaldamine</description>
    <description xml:lang="fi">Asenna tai poista ajureita, ytimiä ja Mesa</description>
    <description xml:lang="fr">Installer ou supprimer des pilotes, des noyaux et Mesa</description>
    <description xml:lang="he">התקנה או הסרה של מנהלי התקנים, ליבות ו-Mesa</description>
    <description xml:lang="hr">Instaliraj ili ukloni upravljačke programe, jezgre i Mesa</description>
    <description xml:lang="hu">Illesztőprogramok, kernelek és a Mesa telepítése vagy eltávolítása</description>
    <description xml:lang="is">Setja upp eða fjarlægja rekla, kjarna og Mesa</description>
    <description xml:lang="it">Installare o rimuovere driver, kernel e Mesa</description>
    <description xml:lang="ja">ドライバー、カーネル、Mesa のインストールまたは削除</description>
    <description xml:lang="ko">드라이버, 커널 및 Mesa 설치 또는 제거</description>
    <description xml:lang="nl">Stuurprogramma's, kernels en Mesa installeren of verwijderen</description>
    <description xml:lang="no">Installer eller fjern drivere, kjerner og Mesa</description>
    <description xml:lang="pl">Instalowanie lub usuwanie sterowników, jąder i Mesa</description>
    <description xml:lang="pt">Instalar ou remover controladores, kernels e Mesa</description>
    <description xml:lang="pt_BR">Instalar ou remover drivers, kernels e Mesa</description>
    <description xml:lang="ro">Instalează sau elimină drivere, nuclee și Mesa</description>
    <description xml:lang="ru">Установка или удаление драйверов, ядер и Mesa</description>
    <description xml:lang="sk">Inštalovať alebo odstrániť ovládače, jadrá a Mesa</description>
    <description xml:lang="sv">Installera eller ta bort drivrutiner, kärnor och Mesa</description>
    <description xml:lang="tr">Sürücü, çekirdek ve Mesa yükle veya kaldır</description>
    <description xml:lang="uk">Встановлення або вилучення драйверів, ядер і Mesa</description>
    <description xml:lang="zh">安装或移除驱动、内核和 Mesa</description>
    <description xml:lang="zh_CN">安装或移除驱动、内核和 Mesa</description>
    <description xml:lang="zh_TW">安裝或移除驅動程式、核心與 Mesa</description>
    <message>Authentication is required to install or remove drivers</message>
    <message xml:lang="be">Для ўсталявання або выдалення драйвераў патрабуецца аўтэнтыфікацыя</message>
    <message xml:lang="bg">За инсталиране или премахване на драйвери е необходимо удостоверяване</message>
    <message xml:lang="cs">Pro instalaci nebo odebrání ovladačů je vyžadováno ověření</message>
    <message xml:lang="da">Godkendelse er påkrævet for at installere eller fjerne drivere</message>
    <message xml:lang="de">Zum Installieren oder Entfernen von Treibern ist eine Authentifizierung erforderlich</message>
    <message xml:lang="el">Απαιτείται πιστοποίηση για την εγκατάσταση ή αφαίρεση οδηγών</message>
    <message xml:lang="es">Se requiere autenticación para instalar o eliminar controladores</message>
    <message xml:lang="et">Draiverite paigaldamiseks või eemaldamiseks on vajalik autentimine</message>
    <message xml:lang="fi">Ajureiden asentaminen tai poistaminen vaatii tunnistautumisen</message>
    <message xml:lang="fr">Une authentification est requise pour installer ou supprimer des pilotes</message>
    <message xml:lang="he">נדרש אימות כדי להתקין או להסיר מנהלי התקנים</message>
    <message xml:lang="hr">Za instalaciju ili uklanjanje upravljačkih programa potrebna je provjera autentičnosti</message>
    <message xml:lang="hu">Illesztőprogramok telepítéséhez vagy eltávolításához hitelesítés szükséges</message>
    <message xml:lang="is">Auðkenningar er krafist til að setja upp eða fjarlægja rekla</message>
    <message xml:lang="it">È richiesta l'autenticazione per installare o rimuovere i driver</message>
    <message xml:lang="ja">ドライバーをインストールまたは削除するには認証が必要です</message>
    <message xml:lang="ko">드라이버를 설치하거나 제거하려면 인증이 필요합니다</message>
    <message xml:lang="nl">Authenticatie is vereist om stuurprogramma's te installeren of te verwijderen</message>
    <message xml:lang="no">Autentisering kreves for å installere eller fjerne drivere</message>
    <message xml:lang="pl">Instalowanie lub usuwanie sterowników wymaga uwierzytelnienia</message>
    <message xml:lang="pt">É necessária autenticação para instalar ou remover controladores</message>
    <message xml:lang="pt_BR">É necessária autenticação para instalar ou remover drivers</message>
    <message xml:lang="ro">Este necesară autentificarea pentru a instala sau elimina drivere</message>
    <message xml:lang="ru">Для установки или удаления драйверов требуется аутентификация</message>
    <message xml:lang="sk">Na inštaláciu alebo odstránenie ovládačov sa vyžaduje overenie</message>
    <message xml:lang="sv">Autentisering krävs för att installera eller ta bort drivrutiner</message>
    <message xml:lang="tr">Sürücü yüklemek veya kaldırmak için kimlik doğrulaması gerekiyor</message>
    <message xml:lang="uk">Для встановлення або вилучення драйверів потрібна автентифікація</message>
    <message xml:lang="zh">安装或移除驱动需要认证</message>
    <message xml:lang="zh_CN">安装或移除驱动需要认证</message>
    <message xml:lang="zh_TW">安裝或移除驅動程式需要認證</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/big-driver-manager-cli</annotate>
  </action>
</policyconfig>
