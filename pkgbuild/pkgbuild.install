#!/usr/bin/env bash
# Installation hooks for big-driver-manager-cli

_build_cache() {
    if [[ -x /usr/share/big-driver-manager-cli/build-ids-cache.sh ]]; then
        /usr/share/big-driver-manager-cli/build-ids-cache.sh || true
    fi
}

post_install() {
    _build_cache
}

post_upgrade() {
    _build_cache
}

post_remove() {
    rm -rf /var/cache/big-driver-manager
}
